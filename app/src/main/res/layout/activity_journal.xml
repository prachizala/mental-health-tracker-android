<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Journal 📓"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Prompt -->
            <TextView
                android:id="@+id/tvPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💭 What made you smile today?"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:background="@color/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- New Entry -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="New Entry" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>

                    <EditText android:id="@+id/etJournalTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Title (optional)" android:background="@drawable/input_bg"
                        android:padding="12dp" android:textSize="14sp" android:layout_marginBottom="10dp"/>

                    <EditText android:id="@+id/etJournalContent"
                        android:layout_width="match_parent" android:layout_height="140dp"
                        android:hint="Write your thoughts here..." android:background="@drawable/input_bg"
                        android:padding="12dp" android:textSize="14sp" android:gravity="top"
                        android:inputType="textMultiLine" android:layout_marginBottom="12dp"/>

                    <Button android:id="@+id/btnSaveJournal"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="Save Entry" android:backgroundTint="@color/primary"
                        android:textColor="#FFFFFF" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Past Entries -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Past Entries" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>

            <LinearLayout android:id="@+id/journalList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
